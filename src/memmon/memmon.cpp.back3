#define CALC_RATIO(numerator, denominator) (((denominator) != 0) ? (((double)(numerator) / (denominator)) * 100) : 0.0)
#define MAX_FNAME_LENGTH 255
#define DEBUG_CALLSTACK false

// --------------------------------------------------
// ptr log 관리용 전역 변수
static FILE *ptr_log_file = nullptr;
static std::mutex ptr_log_mutex;

// 실행 시 자동으로 로그 파일 열기
__attribute__ ((constructor))
static void memmon_open_ptr_log()
{
  const char *home = getenv ("HOME");
  char path[512];
  // ~/CUBRID/databases/memdump/ptr_log.txt에 기록
  snprintf (path, sizeof (path), "%s/CUBRID/databases/memdump/ptr_log.txt",
	    home ? home : "/tmp");
  ptr_log_file = fopen (path, "a");
  if (!ptr_log_file)
    {
      perror ("memmon ptr_log fopen");
    }
}

// 종료 시 자동으로 파일 닫기
__attribute__ ((destructor))
static void memmon_close_ptr_log()
{
  if (ptr_log_file)
    {
      fclose (ptr_log_file);
    }
}
// --------------------------------------------------

// glibc 내부 함수 포인터 초기화
extern "C" {
  void *__libc_malloc (size_t);
  void *__libc_calloc (size_t, size_t);
  void *__libc_realloc (void *, size_t);
  void __libc_free (void *);
}

static void * (*real_malloc) (size_t) = __libc_malloc;
static void * (*real_calloc) (size_t, size_t) = __libc_calloc;
static void * (*real_realloc) (void *, size_t) = __libc_realloc;
static void (*real_free) (void *) = __libc_free;

static bool disable_force = false;

// 재진입 방지를 위한 thread_local 변수
thread_local bool malloc_in_hook = false;
thread_local bool calloc_in_hook = false;
thread_local bool realloc_in_hook = false;
thread_local bool free_in_hook = false;

// RealAllocator: TBB map 내부 할당 시 후킹 영향을 받지 않도록 함
template <typename T>
struct RealAllocator
{
  using value_type = T;
  RealAllocator() noexcept {}
  template <class U>
  RealAllocator (const RealAllocator<U> &) noexcept {}

  T *allocate (std::size_t n)
  {
    void *p = __libc_malloc (n * sizeof (T));
    if (!p)
      {
	throw std::bad_alloc();
      }
    return static_cast<T *> (p);
  }

  void deallocate (T *p, std::size_t) noexcept
  {
    __libc_free (p);
  }
};

template <class T, class U>
bool operator== (const RealAllocator<T> &, const RealAllocator<U> &)
{
  return true;
}
template <class T, class U>
bool operator!= (const RealAllocator<T> &, const RealAllocator<U> &)
{
  return false;
}

// AtomicSize 래퍼 (원자적 업데이트를 지원)
struct AtomicSize
{
  std::atomic<size_t> value;
  AtomicSize() : value (0) {}
  AtomicSize (size_t v) : value (v) {}
  AtomicSize (const AtomicSize &other) : value (other.value.load (std::memory_order_relaxed)) {}
  AtomicSize &operator= (const AtomicSize &other)
  {
    value.store (other.value.load (std::memory_order_relaxed), std::memory_order_relaxed);
    return *this;
  }
  AtomicSize &operator+= (size_t delta)
  {
    value.fetch_add (delta, std::memory_order_relaxed);
    return *this;
  }
  AtomicSize &operator-= (size_t delta)
  {
    value.fetch_sub (delta, std::memory_order_relaxed);
    return *this;
  }
  operator size_t() const
  {
    return value.load (std::memory_order_relaxed);
  }
};

// TBB map 타입 및 lazy 초기화 함수
using MemStatMap = tbb::concurrent_unordered_map<
		   uintptr_t,
		   AtomicSize,
		   std::hash<uintptr_t>,
		   std::equal_to<uintptr_t>,
		   RealAllocator<std::pair<const uintptr_t, AtomicSize>>
		   >;

MemStatMap &get_mem_stat_map()
{
  static MemStatMap instance;
  static bool initialized = []()
  {
    instance.rehash (MEMMON_MAP_RESERVE_SIZE);
    return true;
  }
  ();
  (void)initialized;
  return instance;
}

/* call stack */
using CallStackVector = std::vector<void *, RealAllocator<void *>>;
using CallStackMapRaw = tbb::concurrent_unordered_map<
			uintptr_t,
			CallStackVector,
			std::hash<uintptr_t>,
			std::equal_to<uintptr_t>,
			RealAllocator<std::pair<const uintptr_t, CallStackVector>>
			>;

CallStackMapRaw &get_call_stack_map_raw (void)
{
  static CallStackMapRaw instance;
  return instance;
}

void memmon_print_call_stack (uintptr_t caller_addr)
{
  CallStackMapRaw &map_raw = get_call_stack_map_raw();
  auto it = map_raw.find (caller_addr);
  if (it == map_raw.end())
    {
      printf ("No call stack found for caller address 0x%lx\n", caller_addr);
      return;
    }

  const CallStackVector &cs_vec = it->second;
  char **symbols = backtrace_symbols (cs_vec.data(), cs_vec.size());
  if (symbols)
    {
      printf ("Call stack for caller address 0x%lx:\n====================================\n", caller_addr);
      for (size_t i = 0; i < cs_vec.size(); i++)
	{
	  printf ("%s\n", symbols[i]);
	}
      free (symbols);
    }
  else
    {
      printf ("[X]Call stack for caller address 0x%lx:\n====================================\n", caller_addr);
      for (auto addr : cs_vec)
	{
	  Dl_info info;
	  if (dladdr (addr, &info) && info.dli_sname)
	    {
	      printf ("%p: %s\n", addr, info.dli_sname);
	    }
	  else
	    {
	      printf ("%p\n", addr);
	    }
	}
    }
}

// 메타정보 관련 함수
char *memmon_get_metainfo_pos (void *ptr, size_t size)
{
  return reinterpret_cast<char *> (ptr) + size - ALIGNED_METAINFO_SIZE;
}

size_t memmon_get_payload_size (void *ptr)
{
  MEMMON_METAINFO *metainfo = nullptr;
  size_t payload_size = 0;
  size_t total_size = malloc_usable_size (ptr);

  if (total_size <= ALIGNED_METAINFO_SIZE)
    {
      payload_size = total_size;
    }

  metainfo = reinterpret_cast<MEMMON_METAINFO *> (memmon_get_metainfo_pos (ptr, total_size));
  if (metainfo->magic_number == MAGIC_NUMBER)
    {
      payload_size = metainfo->allocated_size - ALIGNED_METAINFO_SIZE;
    }

  return payload_size;
}

void *memmon_get_initial_mem_call_addr (uintptr_t *caller_addr)
{
  void *return_addr[MAX_TRACE];
  void *func_addr_p = nullptr;
  int trace_count = backtrace (return_addr, MAX_TRACE);

  for (int i = 0; i < trace_count; i++)
    {
      Dl_info dl_info;
      if (dladdr (return_addr[i], &dl_info) == 0 || !dl_info.dli_fname)
	{
	  continue;
	}
      if (strnlen (dl_info.dli_fname, MAX_FNAME_LENGTH) == MAX_FNAME_LENGTH)
	{
	  *caller_addr = 0;
	  return nullptr;
	}
      if (strstr (dl_info.dli_fname, "libmemmon.so") == nullptr &&
	  strstr (dl_info.dli_fname, "libcubrid.so") == nullptr)
	{
	  *caller_addr = 0;
	  return nullptr;
	}
      if (strstr (dl_info.dli_fname, "libcubrid.") == nullptr)
	{
	  continue;
	}

      if (dl_info.dli_fbase >= reinterpret_cast<const void *> (0x40000000))
	{
	  func_addr_p = reinterpret_cast<void *> (
				reinterpret_cast<size_t> (return_addr[i]) -
				reinterpret_cast<size_t> (dl_info.dli_fbase)
			);
	}
      else
	{
	  func_addr_p = return_addr[i];
	}
      *caller_addr = reinterpret_cast<uintptr_t> (func_addr_p);
      break;
    }

#if (DEBUG_CALLSTACK)
  if (func_addr_p)
    {
      CallStackVector cs_vec (return_addr, return_addr + trace_count);
      CallStackMapRaw &map_raw = get_call_stack_map_raw();
      if (map_raw.find (*caller_addr) == map_raw.end())
	{
	  map_raw.emplace (*caller_addr, std::move (cs_vec));
	}
    }
#endif

  return func_addr_p;
}

void memmon_add_stat (void *ptr, const size_t size, uintptr_t caller_addr)
{
  assert (size > ALIGNED_METAINFO_SIZE);

  MEMMON_METAINFO *metainfo = reinterpret_cast<MEMMON_METAINFO *> (
				      memmon_get_metainfo_pos (ptr, size)
			      );
  metainfo->magic_number = MAGIC_NUMBER;
  metainfo->allocated_size = size;
  metainfo->caller_addr = caller_addr;

  MemStatMap &map_ref = get_mem_stat_map();
  auto result = map_ref.emplace (metainfo->caller_addr, AtomicSize (metainfo->allocated_size));
  if (!result.second)
    {
      result.first->second += metainfo->allocated_size;
    }

  // --- 포인터 할당 로그 기록 ---
  if (ptr_log_file)
    {
      std::lock_guard<std::mutex> lg (ptr_log_mutex);
      fprintf (ptr_log_file, "[alloc] ptr: %p\n", ptr);
      fflush (ptr_log_file);
    }
}

void memmon_sub_stat (void *ptr)
{
  if (!ptr)
    {
      return;
    }
  size_t size = malloc_usable_size (ptr);
  if (size <= ALIGNED_METAINFO_SIZE)
    {
      return;
    }

  MEMMON_METAINFO *metainfo = reinterpret_cast<MEMMON_METAINFO *> (
				      memmon_get_metainfo_pos (ptr, size)
			      );
  if (metainfo->magic_number != MAGIC_NUMBER)
    {
      return;
    }

  auto &map_ref = get_mem_stat_map();
  auto it = map_ref.find (metainfo->caller_addr);
  if (it != map_ref.end())
    {
      it->second -= metainfo->allocated_size;
    }
  else
    {
      assert(false);
    }
    
  // --- 포인터 해제 로그 기록 ---
  if (ptr_log_file)
    {
      std::lock_guard<std::mutex> lg (ptr_log_mutex);
      fprintf (ptr_log_file, "[free ] ptr: %p\n", ptr);
      fflush (ptr_log_file);
    }
}

// 메모리 후킹 함수들
extern "C" {
  void *malloc (size_t size)
  {
    if (malloc_in_hook || disable_force)
      {
	return real_malloc (size);
      }

    malloc_in_hook = true;
    uintptr_t caller_addr = 0;
    void *ptr = nullptr;

    if (memmon_get_initial_mem_call_addr (&caller_addr) != nullptr)
      {
	size_t total_size = size + ALIGNED_METAINFO_SIZE;
	ptr = real_malloc (total_size);
	if (ptr)
	  {
	    memmon_add_stat (ptr, total_size, caller_addr);
	  }
      }
    else
      {
	ptr = real_malloc (size);
      }

    malloc_in_hook = false;
    return ptr;
  }

  void *calloc (size_t nmemb, size_t size)
  {
    if (calloc_in_hook || disable_force)
      {
	return real_calloc (nmemb, size);
      }

    calloc_in_hook = true;
    uintptr_t caller_addr = 0;
    void *ptr = nullptr;

    if (memmon_get_initial_mem_call_addr (&caller_addr) != nullptr)
      {
	size_t total_size = nmemb * size + ALIGNED_METAINFO_SIZE;
	ptr = real_calloc (1, total_size);
	if (ptr)
	  {
	    memmon_add_stat (ptr, total_size, caller_addr);
	  }
      }
    else
      {
	ptr = real_calloc (nmemb, size);
      }

    calloc_in_hook = false;
    return ptr;
  }

  void *realloc (void *ptr, size_t size)
  {
    if (realloc_in_hook || disable_force)
      {
	return real_realloc (ptr, size);
      }

    realloc_in_hook = true;
    void *new_ptr = nullptr;
    if (!ptr)
      {
	realloc_in_hook = false;
	return malloc (size);
      }
    if (size == 0)
      {
	free (ptr);
	realloc_in_hook = false;
	return nullptr;
      }

    uintptr_t caller_addr = 0;
    if (memmon_get_initial_mem_call_addr (&caller_addr) != nullptr)
      {
	new_ptr = malloc (size);
	if (new_ptr)
	  {
	    size_t old_sz = memmon_get_payload_size (ptr);
	    size_t copy_sz = (old_sz < size ? old_sz : size);
	    memcpy (new_ptr, ptr, copy_sz);
	    free (ptr);
	  }
      }
    else
      {
	realloc_in_hook = false;
	return real_realloc (ptr, size);
      }

    realloc_in_hook = false;
    return new_ptr;
  }

  void free (void *ptr)
  {
    if (!ptr)
      {
	return;
      }
    if (free_in_hook || disable_force)
      {
	real_free (ptr);
	return;
      }

    free_in_hook = true;
    memmon_sub_stat (ptr);
    real_free (ptr);
    free_in_hook = false;
  }
}

// operator new/delete 후킹
void *operator new (std::size_t size)
{
  void *ptr = malloc (size);
  if (!ptr)
    {
      throw std::bad_alloc();
    }
  return ptr;
}

void *operator new[] (std::size_t size)
{
  void *ptr = malloc (size);
  if (!ptr)
    {
      throw std::bad_alloc();
    }
  return ptr;
}

void operator delete (void *ptr) noexcept
{
  if (ptr)
    {
      free (ptr);
    }
}

void operator delete[] (void *ptr) noexcept
{
  if (ptr)
    {
      free (ptr);
    }
}

void operator delete (void *ptr, std::size_t) noexcept
{
  if (ptr)
    {
      free (ptr);
    }
}

void operator delete[] (void *ptr, std::size_t) noexcept
{
  if (ptr)
    {
      free (ptr);
    }
}

// memmon_trim_function_name: 경로 문자열 가공
static const char *memmon_trim_function_name (char *path)
{
  size_t len = strlen (path);
  if (len && path[len - 1] == '\n')
    {
      path[len - 1] = '\0';
    }

  const char *last_slash = strrchr (path, '/');
  if (!last_slash)
    {
      last_slash = path;
    }
  else
    {
      const char *second_last = nullptr;
      for (const char *p = last_slash - 1; p >= path; --p)
	{
	  if (*p == '/')
	    {
	      second_last = p;
	      break;
	    }
	}
      last_slash = second_last ? second_last : path;
    }

  char *res = (char *)last_slash;
  char *sp = strchr (res, ' ');
  if (sp)
    {
      *sp = '\0';
    }
  return res;
}

const char *memmon_resolve_function_name (const void *address, char *buffer)
{
  FILE *output = nullptr;
  char cmd_line[BUFFER_SIZE] = {0};
  const char *fixed_lib = "/home/heexoo/CUBRID/lib/libcubrid.so.11.4";

  snprintf (cmd_line, sizeof (cmd_line),
	    "addr2line -e %s %p 2> /dev/null",
	    fixed_lib, address);
  output = popen (cmd_line, "r");
  if (!output)
    {
      return nullptr;
    }

  const char *fn = fgets (buffer, BUFFER_SIZE - 1, output);
  pclose (output);
  if (!fn || !fn[0])
    {
      return nullptr;
    }

#if (DEBUG_CALLSTACK)
  if (strchr (buffer, '?'))
    {
      printf ("\nfile:line : %s\n", buffer);
      memmon_print_call_stack (reinterpret_cast<uintptr_t> (address));
    }
#endif

  return memmon_trim_function_name (buffer);
}

// memmon_open_dump_file: memory_dump_YYYYMMDD_HHMMSS.txt 생성
FILE *memmon_open_dump_file (void)
{
  char filename[512] = {0}, datetime[64] = {0};
  time_t now = time (nullptr);
  struct tm tm_now;
  localtime_r (&now, &tm_now);
  strftime (datetime, sizeof (datetime),
	    "memory_dump_%Y%m%d_%H%M%S.txt", &tm_now);

  const char *dump_dir = getenv ("HOME");
  if (!dump_dir)
    {
      dump_dir = "/home/heexoo";
    }

  snprintf (filename, sizeof (filename),
	    "%s/CUBRID/databases/memdump/%s",
	    dump_dir, datetime);

  FILE *fp = fopen (filename, "w");
  if (!fp)
    {
      perror ("fopen");
    }
  return fp;
}

#ifdef __cplusplus
extern "C" {
#endif

int memmon_dump_memory_usage (void)
{
  int error = NO_ERROR;
  double ratio = 0;
  char buffer[BUFFER_SIZE] = {0};
  size_t usage = 0, total_usage = 0;
  int count = 0;
  const char *func_name = nullptr;
  FILE *outfile_fp = nullptr;

  MemStatMap &map_ref = get_mem_stat_map();
  tbb::concurrent_unordered_map<std::string, size_t> func_usage;

  for (const auto &entry : map_ref)
    {
      memset (buffer, 0, sizeof (buffer));
      if (reinterpret_cast<const void *> (entry.first) == NULL)
	{
	  continue;
	}
      func_name = memmon_resolve_function_name (
			  reinterpret_cast<const void *> (entry.first),
			  buffer);
      if (!func_name || !func_name[0])
	{
	  continue;
	}

      std::string key (func_name);
      usage = entry.second;
      func_usage[key] += usage;
      total_usage += usage;
      count++;
    }

  std::vector<std::pair<std::string, size_t>> stats (func_usage.begin(), func_usage.end());
  std::sort (stats.begin(), stats.end(),
	     [] (auto &a, auto &b)
  {
    return a.second > b.second;
  });

  outfile_fp = memmon_open_dump_file();
  if (!outfile_fp)
    {
      return ER_FAILED;
    }

  fprintf (outfile_fp, "==================== Memory Usage Dump ====================\n");
  fprintf (outfile_fp, "Total Memory Usage: %lu Bytes (%lu MB)\n",
	   total_usage, total_usage/1024/1024);
  fprintf (outfile_fp, "MetaInfo Size: %lu Bytes\n\n", count * ALIGNED_METAINFO_SIZE);
  fprintf (outfile_fp, "%-60s | %-15s | %s\n",
	   "Function Name", "Memory Usage", "Ratio (%)");
  fprintf (outfile_fp,
	   "---------------------------------------------------------------------\n");

  for (auto &stat : stats)
    {
      ratio = CALC_RATIO (stat.second, total_usage);
      fprintf (outfile_fp, "%-60s | %-15zu | %7.2f%%\n",
	       stat.first.c_str(), stat.second, ratio);
    }

  fprintf (outfile_fp, "=====================================================================\n");
  fflush (outfile_fp);
  fclose (outfile_fp);
  printf ("Memory usage dump written to file.\n");
  return error;
}

int memmon_disabled_force (void)
{
  disable_force = true;
  return NO_ERROR;
}

#ifdef __cplusplus
}
#endif
