index 000000000..222053e64
--- /dev/null
+++ b/src/memmon/memmon.cpp
@@ -0,0 +1,657 @@
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <dlfcn.h>
+#include <execinfo.h>
+#include <new>
+#include <cstdint>
