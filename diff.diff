+// trim_function_name: 경로 문자열에서 마지막에서 두 번째 '/'부터 시작하는 부분을 반환하고,
+//                    문자열 끝의 개행 문자('\n')도 제거한다.
+// 예) "/home/heexoo/workspace/cubrid/src/transaction/log_compress.c:206\n" → "/src/transaction/log_compress.c:206"
+static const char *trim_function_name (char *path)
+{
+  size_t len = strlen(path);
+  if (len > 0 && path[len - 1] == '\n')
+    {
+      path[len - 1] = '\0';
+    }
+
+  const char *last_slash = strrchr(path, '/');
+  if (!last_slash)
+    {
+      last_slash = path;
+    }
+  else
+    {
+      // 마지막 슬래시보다 앞쪽부터 역순으로 두 번째 슬래시를 찾음
+      const char *second_last = nullptr;
+      for (const char *p = last_slash - 1; p >= path; p--)
+	{
+	  if (*p == '/')
+	    {
+	      second_last = p;
+	      break;
+	    }
+	}
+      last_slash = second_last ? second_last : path;
+    }
+
+  // 마지막에서 두 번째 '/'부터 시작하는 부분에서 첫 번째 공백 찾기
+  char *result = (char *)last_slash;
+  char *space_ptr = strchr(result, ' ');
+  if (space_ptr)
+    {
+      *space_ptr = '\0';
+    }
+
+  return result;
+}
